{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mim-orders",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://mim-kulinariya.com,https://www.mim-kulinariya.com"
  },
  "durable_objects": {
    "bindings": [{ "name": "ORDER_DELIVERY", "class_name": "OrderDelivery" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrderDelivery"] }],
  "ratelimits": [{ "name": "ORDER_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false }
}
